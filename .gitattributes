# Normalize text files to LF in the repo, let git convert on checkout
# per the user's own core.autocrlf setting.
* text=auto eol=lf

# CAD / mechanical design files - never diff or line-ending-convert these
*.step binary
*.stp binary
*.stl binary
*.f3d binary
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
# Firmware build artifacts, if ever committed by accident
*.hex binary
*.bin binary
*.elf binary
*.dat binary
# App release
*.apk binary
*.zip binary
Apps/Android/app-release/*.apk filter=lfs diff=lfs merge=lfs -text
